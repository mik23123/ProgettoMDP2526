<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="667.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.universita.mdp2526.gui.Controller.MenuController">

    <children>
        <!-- Immagine di sfondo -->
        <ImageView fitHeight="400.0" fitWidth="667.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@bambino.jpg" />
            </image>
        </ImageView>

        <!-- Pulsanti -->
        <Button layoutX="31.0" layoutY="331.0" mnemonicParsing="false" onAction="#studyStart" text="Studia" />
        <Button layoutX="138.0" layoutY="331.0" mnemonicParsing="false" onAction="#examStart" text="Sfida Il Prof" />
        <Button layoutX="366.0" layoutY="331.0" mnemonicParsing="false" onAction="#hangOutWithFriendsStart" text="Esci W friends" />
        <Button layoutX="515.0" layoutY="331.0" mnemonicParsing="false" onAction="#save" text="Salva" />
        <Button layoutX="600.0" layoutY="331.0" mnemonicParsing="false" onAction="#exit" text="Esci" textFill="#f20707" />
        <Button layoutX="266.0" layoutY="331.0" mnemonicParsing="false" onAction="#sleepStart" text="Dormi" />

        <!-- Barre di avanzamento -->
        <ProgressBar fx:id="lifeBar" layoutX="58.0" layoutY="255.0" prefHeight="20.0" prefWidth="107.0" />
        <ProgressBar fx:id="stressBar" layoutX="299.0" layoutY="255.0" prefHeight="20.0" prefWidth="107.0" />
        <ProgressBar fx:id="energyBar" layoutX="537.0" layoutY="255.0" prefHeight="20.0" prefWidth="107.0" />

        <!-- Label con sfondo bianco e bordi leggermente arrotondati -->
        <Label fx:id="notify" layoutX="110.0" layoutY="14.0" prefHeight="20.0" prefWidth="436.0" style="-fx-background-color: white; -fx-padding: 2 5 2 5; -fx-background-radius: 3;" />

        <Label layoutX="328.0" layoutY="285.0" prefHeight="17.0" style="-fx-background-color: white; -fx-padding: 2 5 2 5; -fx-background-radius: 3;" text="Stress" />

        <Label layoutX="98.0" layoutY="285.0" style="-fx-background-color: white; -fx-padding: 2 5 2 5; -fx-background-radius: 3;" text="Vita" />

        <Label layoutX="571.0" layoutY="285.0" style="-fx-background-color: white; -fx-padding: 2 5 2 5; -fx-background-radius: 3;" text="Energia" />

    </children>

</AnchorPane>
