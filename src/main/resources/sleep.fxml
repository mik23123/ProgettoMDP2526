      <Button layoutX="89.0" layoutY="111.0" mnemonicParsing="false" onAction="#sleep" text="Conferma" />
      <Button layoutX="529.0" layoutY="350.0" mnemonicParsing="false" onAction="#exit" styleClass="exitButton" text="esci" />

   </children>
